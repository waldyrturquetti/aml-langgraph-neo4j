NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test-password
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/test-password
NEO4J_MAX_HOPS=2
AML_ALERT_EVIDENCE_LIMIT=10

# Retry/typology detection tuning (optional; defaults shown).
# AML_ALERT_MAX_ENRICHMENT_ATTEMPTS bounds the enrich<->widen_search retry
# loop; NEO4J_MAX_HOPS is also the ceiling hop_radius can widen to.
# AML_ALERT_MIN_EVIDENCE_FOR_CONCLUSION is how many evidence items must be
# found before the workflow stops widening the search radius.
AML_ALERT_MAX_ENRICHMENT_ATTEMPTS=2
AML_ALERT_MIN_EVIDENCE_FOR_CONCLUSION=2
AML_ALERT_CYCLE_MAX_HOPS=6
AML_ALERT_STRUCTURING_FANOUT_THRESHOLD=4
AML_ALERT_STRUCTURING_FANIN_THRESHOLD=4

# LLM insight generation (optional). Leave AML_ALERT_LLM_ENABLED=false to run
# fully offline with deterministic, rule-based insights.
AML_ALERT_LLM_ENABLED=false
AML_ALERT_LLM_PROVIDER=rule-based
AML_ALERT_LLM_MODEL=local-insight-summarizer
AML_ALERT_LLM_TIMEOUT_SECONDS=15

# To use the real Claude API instead of the offline rule-based provider, set:
#   AML_ALERT_LLM_ENABLED=true
#   AML_ALERT_LLM_PROVIDER=anthropic
#   AML_ALERT_LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
