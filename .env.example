NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test-password
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/test-password
NEO4J_MAX_HOPS=2
AML_ALERT_EVIDENCE_LIMIT=10

# Retry/typology detection tuning (optional; defaults shown).
# AML_ALERT_MAX_ENRICHMENT_ATTEMPTS bounds the enrich<->widen_search retry
# loop; NEO4J_MAX_HOPS is also the ceiling hop_radius can widen to (a real
# per-hop traversal, not just 1-2 hops).
# AML_ALERT_MIN_EVIDENCE_FOR_CONCLUSION is how many evidence items must be
# found before the workflow stops widening the search radius.
AML_ALERT_MAX_ENRICHMENT_ATTEMPTS=2
AML_ALERT_MIN_EVIDENCE_FOR_CONCLUSION=2
AML_ALERT_CYCLE_MAX_HOPS=6
AML_ALERT_STRUCTURING_FANOUT_THRESHOLD=4
AML_ALERT_STRUCTURING_FANIN_THRESHOLD=4

# How many hops the alert-proximity check (is this customer connected to
# someone who already has an Alert?) is allowed to traverse. Independent
# from AML_ALERT_CYCLE_MAX_HOPS - a different tuning knob for a different
# typology.
AML_ALERT_PROXIMITY_MAX_HOPS=3

# LLM insight generation. This single toggle switches between static and
# real-LLM insights - it does not require any other code/config change:
#   AML_ALERT_LLM_ENABLED=false -> deterministic, evidence-grounded rule-based
#     insights, fully offline, no network call, no API key needed.
#   AML_ALERT_LLM_ENABLED=true  -> a real LLM call to the provider selected by
#     AML_ALERT_LLM_PROVIDER below.
AML_ALERT_LLM_ENABLED=false

# Which real LLM to call when AML_ALERT_LLM_ENABLED=true. Only relevant in
# that case; switch providers or models purely by editing this file, no
# code change required.
#   AML_ALERT_LLM_PROVIDER=anthropic -> Claude API (requires ANTHROPIC_API_KEY)
#   AML_ALERT_LLM_PROVIDER=openai    -> OpenAI API (requires OPENAI_API_KEY)
AML_ALERT_LLM_PROVIDER=anthropic
AML_ALERT_LLM_MODEL=local-insight-summarizer
AML_ALERT_LLM_TIMEOUT_SECONDS=15

# Reasoning ("thinking") effort forwarded to reasoning-capable OpenAI models
# (the `o` series, gpt-5). Only applies when AML_ALERT_LLM_PROVIDER=openai.
# Leave unset to use the default (medium); set to low/medium/high to
# override, or clear it if you point AML_ALERT_LLM_MODEL at a non-reasoning
# model.
AML_ALERT_LLM_REASONING_EFFORT=

# Required only when AML_ALERT_LLM_PROVIDER=anthropic and LLM is enabled.
ANTHROPIC_API_KEY=

# Required only when AML_ALERT_LLM_PROVIDER=openai and LLM is enabled.
OPENAI_API_KEY=

# Example: run with the real Claude API
#   AML_ALERT_LLM_ENABLED=true
#   AML_ALERT_LLM_PROVIDER=anthropic
#   AML_ALERT_LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Example: run with the real OpenAI API (with reasoning)
#   AML_ALERT_LLM_ENABLED=true
#   AML_ALERT_LLM_PROVIDER=openai
#   AML_ALERT_LLM_MODEL=gpt-5
#   AML_ALERT_LLM_REASONING_EFFORT=medium
#   OPENAI_API_KEY=sk-...

# Alert investigation snapshot store (DynamoDB Local via docker-compose).
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_NAME=aml-alert-snapshots
DYNAMODB_REGION=us-east-1
